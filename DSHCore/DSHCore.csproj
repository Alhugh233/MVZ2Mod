<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DSHCore—— MVZ2 模组开发工具 + 前置库（BepInEx 6 / Il2CppInterop）

    提供内容 mod 共用的通用基建（详见 AI_GUIDE.md）：
      - ClassInjector 缺陷修复（基类泛型虚方法 / System.String 被重写）
      - 注入类 vtable 槽重绑，并在游戏关键调用点兜底
      - 磁盘 XML metas 注入（绕过 Addressables provider 链路）
      - SaveManager 存档兜底、arcade 条目 Index 平移
      - 公共 API：Il2CppPin / InjectedMod / ModBootstrap / ModInfos / CoreRegistry

    构建环境自包含在仓库 runtime/ 目录（三个 mod 共用）：
      runtime\winhttp.dll / dotnet\ / BepInEx\core|interop|unity-libs
    维护 runtime/：跑 tools\sync-runtime.ps1 从已安装的游戏目录刷新。

    GameDir 仅作可选部署目标，不存在时跳过部署。

    注意：插件 GUID 与 Harmony ID 都刻意保持为历史的 qoznos.mvz2.core 前缀。
    改这个字符串会让既有 mod 的 BepInDependency 声明全部失效。
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>DSHCore</AssemblyName>
    <RootNamespace>DSHCore</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 仓库内自包含运行环境（构建引用的唯一来源） -->
    <RuntimeDir>$(MSBuildThisFileDirectory)..\runtime\</RuntimeDir>
    <RuntimeCoreDir>$(RuntimeDir)BepInEx\core\</RuntimeCoreDir>
    <RuntimeInteropDir>$(RuntimeDir)BepInEx\interop\</RuntimeInteropDir>
    <!-- 可选部署目标（测试用游戏目录，不存在则只构建不部署） -->
    <GameDir Condition="'$(GameDir)' == ''">E:\Game\PVZ\MVZ2\MVZ2 0.7.0 test-4\</GameDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 6 核心程序集（与 runtime/ 内版本完全一致） -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(RuntimeCoreDir)BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(RuntimeCoreDir)BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(RuntimeCoreDir)Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RuntimeCoreDir)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 0.7.0 win32_debug 类型代理程序集（预生成） -->
    <Reference Include="$(RuntimeInteropDir)*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 构建后拷贝到部署游戏目录（仅当 GameDir 存在时） -->
  <Target Name="CopyToPlugins" AfterTargets="Build"
          Condition="Exists('$(GameDir)MinecraftVSZombies2.exe')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)BepInEx\plugins\" />
  </Target>

</Project>
