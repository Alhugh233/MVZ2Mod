<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DSHCore—— MVZ2 模组开发工具 + 前置库（BepInEx 6 / Il2CppInterop）

    提供内容 mod 共用的通用基建（详见 AI_GUIDE.md）：
      - ClassInjector 缺陷修复（基类泛型虚方法 / System.String 被重写）
      - 注入类 vtable 槽重绑，并在游戏关键调用点兜底
      - 磁盘 XML metas 注入（绕过 Addressables provider 链路）
      - SaveManager 存档兜底、arcade 条目 Index 平移
      - 公共 API：Il2CppPin / InjectedMod / ModBootstrap / ModInfos / CoreRegistry

    构建环境自包含在仓库 runtime/ 目录（三个 mod 共用）：
      runtime\winhttp.dll / dotnet\ / BepInEx\core|interop|unity-libs
    维护 runtime/：跑 tools\sync-runtime.ps1 从已安装的游戏目录刷新。

    GameDir 仅作可选部署目标，不存在时跳过部署。

    注意：插件 GUID 与 Harmony ID 都刻意保持为历史的 qoznos.mvz2.core 前缀。
    改这个字符串会让既有 mod 的 BepInDependency 声明全部失效。
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>DSHCore</AssemblyName>
    <RootNamespace>DSHCore</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <!-- 共享编译环境解析（RuntimeDir / RuntimeCoreDir / RuntimeInteropDir /
         GameDir）由同目录的 Directory.Build.props 转发到仓库根的配置。 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 6 核心程序集（与 runtime/ 内版本完全一致） -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(RuntimeCoreDir)BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(RuntimeCoreDir)BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(RuntimeCoreDir)Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RuntimeCoreDir)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 0.7.0 win32_debug 类型代理程序集（预生成） -->
    <Reference Include="$(RuntimeInteropDir)*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 网页日志查看器的前端页面。
         内嵌进 DLL 而不是放磁盘：不需要 Node 工具链打包，没有运行时资源路径
         解析问题，也不会出现「页面与 DLL 版本不一致」。
         运行时可用 <BepInEx>\config\DSHCore\logviewer.html 覆盖它（改前端不用重编译）。 -->
    <EmbeddedResource Include="Diagnostics\logviewer.html" LogicalName="DSHCore.logviewer.html" />
  </ItemGroup>

  <!-- 构建后拷贝到部署游戏目录（仅当 GameDir 有效时） -->
  <Target Name="CopyToPlugins" AfterTargets="Build"
          Condition="'$(GameDir)' != '' And Exists('$(GameDir)MinecraftVSZombies2.exe')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)BepInEx\plugins\" />
  </Target>

  <!-- 同步生成给「不附带 DSHCore 源码的环境」用的编译引用。
       只拿到 mod 源码的开发者 / DevKit 包引用的是 _refs\DSHCore\DSHCore.dll，
       所以它必须在每次构建后保持最新，否则会出现「引用的是旧 DSHCore」这种
       极难排查的幽灵问题。-->
  <Target Name="SyncDshCoreRefs" AfterTargets="Build">
    <PropertyGroup>
      <DshCoreRefOutDir>$(MSBuildThisFileDirectory)..\_refs\DSHCore\</DshCoreRefOutDir>
    </PropertyGroup>
    <MakeDir Directories="$(DshCoreRefOutDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DshCoreRefOutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb"
          DestinationFolder="$(DshCoreRefOutDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    <Message Importance="high" Text="[SyncDshCoreRefs] 编译引用已刷新：$(DshCoreRefOutDir)DSHCore.dll" />
  </Target>

</Project>
