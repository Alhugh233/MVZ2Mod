				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\build.ps1",
				"-Mod",
				"dsh",
				"-PackDevKit"
			],
			"problemMatcher": []
		},
		{
			"label": "同步 runtime（从游戏目录）",
			"detail": "把游戏目录的 BepInEx 运行环境刷回 runtime/（新克隆仓库后、或游戏本体更新后执行）",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\tools\\sync-runtime.ps1"
			],
			"problemMatcher": []
		},
		{
			"label": "清理构建产物",
			"detail": "删除所有 mod 的 bin/ obj/",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Remove-Item -Recurse -Force '${workspaceFolder}\\DSHCore\\bin','${workspaceFolder}\\DSHCore\\obj','${workspaceFolder}\\LaboratoryMod\\bin','${workspaceFolder}\\LaboratoryMod\\obj','${workspaceFolder}\\ModularCurse\\bin','${workspaceFolder}\\ModularCurse\\obj','${workspaceFolder}\\Loadout\\bin','${workspaceFolder}\\Loadout\\obj','${workspaceFolder}\\UiGallery\\bin','${workspaceFolder}\\UiGallery\\obj','${workspaceFolder}\\Replay\\bin','${workspaceFolder}\\Replay\\obj' -ErrorAction SilentlyContinue; Write-Host 'bin/obj 已清理'"
			],
			"problemMatcher": []
		},
		{
			"label": "构建: Replay",
			"detail": "回放录制 mod（开发者工具，依赖 DSHCore）",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\Replay\\build.ps1"
			],
			"group": "build"
		},
		{
			"label": "构建 + 启动: Replay",
			"detail": "构建后在测试游戏目录里启动游戏（进入关卡即自动开始录制）",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\Replay\\build.ps1",
				"-Launch"
			],
			"group": "build"
		},
		{
			"label": "自测: Replay GUI（插件页 → 回放）",
			"detail": "无人值守：游戏自己切到插件页、等入口装好、点开回放页、dump 布局 + 截图，报告写 _replay_gui.txt",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\tools\\run-replay-gui-test.ps1",
				"-TimeoutSec",
				"300"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "关掉 Replay GUI 自测开关",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\tools\\run-replay-gui-test.ps1",
				"-Off"
			],
			"problemMatcher": [],
			"group": "build"
		}
	]
