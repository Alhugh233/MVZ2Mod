{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "构建全部",
			"detail": "依次构建 DSHCore / LaboratoryMod / ModularCurse（有游戏目录则自动部署）",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\build.ps1"
			],
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "构建全部 + 打包",
			"detail": "构建三个 mod 并输出可分发 zip 到 dist\\",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\build.ps1",
				"-Pack"
			],
			"problemMatcher": []
		},
		{
			"label": "构建全部 + 打包 + 启动",
			"detail": "构建 → 打包 → 启动游戏冒烟",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\build.ps1",
				"-Pack",
				"-Launch"
			],
			"problemMatcher": []
		},
		{
			"label": "构建: DSHCore",
			"detail": "工具 + 前置库（唯一携带 BepInEx 运行环境的包）",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\build.ps1",
				"-Mod",
				"dsh"
			],
			"problemMatcher": []
		},
		{
			"label": "构建: LaboratoryMod",
			"detail": "实验室关卡（real_prologue / zero_k_space / unknow_palace）",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\build.ps1",
				"-Mod",
				"lab"
			],
			"problemMatcher": []
		},
		{
			"label": "构建: ModularCurse",
			"detail": "模块化诅咒（QC 池 + SC 池）",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\build.ps1",
				"-Mod",
				"curse"
			],
			"problemMatcher": []
		},
		{
			"label": "构建: ModularCurse + 打包 + 启动",
			"detail": "诅咒 mod 的日常开发回路",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\build.ps1",
				"-Mod",
				"curse",
				"-Pack",
				"-Launch"
			],
			"problemMatcher": []
		},
		{
			"label": "同步 runtime（从游戏目录）",
			"detail": "把游戏目录的 BepInEx 运行环境刷回 runtime/（新克隆仓库后、或游戏本体更新后执行）",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\tools\\sync-runtime.ps1"
			],
			"problemMatcher": []
		},
		{
			"label": "清理构建产物",
			"detail": "删除三个 mod 的 bin/ obj/",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Remove-Item -Recurse -Force '${workspaceFolder}\\DSHCore\\bin','${workspaceFolder}\\DSHCore\\obj','${workspaceFolder}\\LaboratoryMod\\bin','${workspaceFolder}\\LaboratoryMod\\obj','${workspaceFolder}\\ModularCurse\\bin','${workspaceFolder}\\ModularCurse\\obj' -ErrorAction SilentlyContinue; Write-Host 'bin/obj 已清理'"
			],
			"problemMatcher": []
		},
		{
			"label": "查看 BepInEx 日志",
			"detail": "查看测试游戏目录的 BepInEx\\LogOutput.log 尾部",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"$p='E:\\Game\\PVZ\\MVZ2\\MVZ2 0.7.0 test-4\\BepInEx\\LogOutput.log'; if (Test-Path $p) { Get-Content $p -Tail 60 } else { Write-Host (\"找不到 \" + $p) }"
			],
			"problemMatcher": []
		},
		{
			"label": "查看 BepInEx 错误日志",
			"detail": "原生崩溃的托管栈只在 ErrorLog.log 里",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"$p='E:\\Game\\PVZ\\MVZ2\\MVZ2 0.7.0 test-4\\BepInEx\\ErrorLog.log'; if (Test-Path $p) { Get-Content $p -Tail 60 } else { Write-Host (\"找不到 \" + $p) }"
			],
			"problemMatcher": []
		}
	]
}
