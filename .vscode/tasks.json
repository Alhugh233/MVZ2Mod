{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "构建全部",
			"detail": "依次构建 DSHCore / LaboratoryMod / ModularCurse / Loadout / UiGallery（有游戏目录则自动部署）",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\build.ps1"
			],
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "构建全部 + 打包",
			"detail": "构建所有 mod 并输出可分发 zip 到 dist\\",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\build.ps1",
				"-Pack"
			],
			"problemMatcher": []
		},
		{
			"label": "构建全部 + 打包 + 启动",
			"detail": "构建 → 打包 → 启动游戏冒烟",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\build.ps1",
				"-Pack",
				"-Launch"
			],
			"problemMatcher": []
		},
		{
			"label": "构建全部 + 模组包（.mvz2pack）",
