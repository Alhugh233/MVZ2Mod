			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\build.ps1",
				"-Mvz2Pack"
			],
			"problemMatcher": []
		},
