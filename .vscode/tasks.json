				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\build.ps1",
				"-Mod",
				"lab"
			],
			"problemMatcher": []
		},
		{
			"label": "构建: ModularCurse",
			"detail": "模块化诅咒（QC 池 + SC 池）",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\build.ps1",
				"-Mod",
				"curse"
			],
			"problemMatcher": []
		},
		{
			"label": "构建: ModularCurse + 打包 + 启动",
			"detail": "诅咒 mod 的日常开发回路",
			"type": "shell",
			"command": "powershell",
			"args": [
