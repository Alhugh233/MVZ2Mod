<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MVZ2 Laboratory Mod —— 实验室内容 Mod（依赖 DSHCore 前置库）
    提供 0.6.4 laboratory 分支移植的实验小游戏关卡定义与行为：
      real_prologue / zero_k_space / unknow_palace

    0.7 官方链集成方式：
      - ModInfo.Logic 直接是注入的 LabMod.CreateInstance()（LoadMods 不再重建 Logic）
      - 关卡定义由 LoadStagesPatch 在官方 LoadStages 时机创建
      - XML metas 由 DSHCore.MetaInjection 注入 → ModLoader.LoadStages/LoadStageProperties
        官方自动完成关卡定义创建与 meta 属性应用

    构建环境自包含在仓库 runtime/（与 DSHCore 共用）。
    GameDir 仅作可选部署目标，不存在时跳过部署。
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>LaboratoryMod</AssemblyName>
    <RootNamespace>LaboratoryMod</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <!-- 共享编译环境解析（RuntimeDir / RuntimeCoreDir / RuntimeInteropDir /
         GameDir，以及 DSHCore 前置的引用方式）由同目录的
         Directory.Build.props 转发到仓库根的配置。 -->
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(RuntimeCoreDir)BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(RuntimeCoreDir)BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(RuntimeCoreDir)Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RuntimeCoreDir)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(RuntimeInteropDir)*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 构建后拷贝到部署游戏目录（仅当 GameDir 有效时） -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(GameDir)' != '' And Exists('$(GameDir)MinecraftVSZombies2.exe')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)BepInEx\plugins\" />
  </Target>

  <!-- 构建后自动部署 Mod 资源到部署游戏目录（仅当 GameDir 有效时）
       assets/ 的内容直接映射到 StreamingAssets\Mods\mvz2_lab\ -->
  <Target Name="DeployModAssets" AfterTargets="Build" Condition="'$(GameDir)' != '' And Exists('$(GameDir)MinecraftVSZombies2.exe')">
    <ItemGroup>
      <ModAsset Include="assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModAsset)" DestinationFiles="@(ModAsset->'$(GameDir)MinecraftVSZombies2_Data\StreamingAssets\Mods\mvz2_lab\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="[DeployModAssets] @(ModAsset-&gt;Count()) 个资源文件已部署到 $(GameDir)MinecraftVSZombies2_Data\StreamingAssets\Mods\mvz2_lab\" />
  </Target>

</Project>
