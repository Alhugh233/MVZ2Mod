<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MVZ2 Replay —— 关卡回放录制 mod（依赖 DSHCore 前置库）。

    记录模型（详见同目录 DESIGN.md）：
      · 起始关键帧 = LevelController.SaveGame()（= 整关 SerializableLevelController）
      · 动作日志   = 玩家输入的 5 个汇聚点（格子 / 实体 / 选卡 / 选卡热键 / 草坪）
                     + 手持物状态变化（工具按钮与热键）
      · 指纹校验   = 每 N tick 采样（能量 / 波次 / 旗数 + 7 条 RNG 的哈希）

    文件 .mrep = gzip 压缩的逐行 JSON：
      第 1 行 header，之后是 keyframe / 事件 / 指纹，每行一个 JSON 对象。

    为什么是「语义事件」而不是原始鼠标键盘：见 DESIGN.md 第 3 节。
    本 mod 目前只做**录制**（写出 .mrep），播放留给下一阶段。
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>Replay</AssemblyName>
    <RootNamespace>Replay</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!--
    ── 诊断 / 自测代码的编译开关 ─────────────────────────────────────────
    Diagnostics\ 下面全是**排查与自测用**的代码（崩溃探针、自动化验收、
    布局 dump），发布版本一个字节都不该带出去：

      默认（发布）  .\build.ps1
                    → Diagnostics\**\*.cs 整个不参与编译，DIAGNOSTICS 未定义
      诊断构建      .\build.ps1 -Diagnostics
                    → 编进来并定义 DIAGNOSTICS（ReplayConfig 的自测/探针配置段、
                      以及 Game\ 里那些 #if DIAGNOSTICS 的调用点才会一起进来）

    为什么要编译期隔离而不是「配置项关掉就算了」：探针本身就会改变行为
    ——例如给 IsAssignableFrom 挂前缀、给 Addressables 的 Locate 挂前缀，
    在 0.7.0 上都会把「游戏自己的访问违例」变成「进程静默消失」，
    留在 DLL 里就是一颗随时会响的雷。
  -->
  <PropertyGroup>
    <Diagnostics Condition="'$(Diagnostics)' == ''">false</Diagnostics>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Diagnostics)' == 'true'">
    <DefineConstants>$(DefineConstants);DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(Diagnostics)' != 'true'">
    <Compile Remove="Diagnostics\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx 6 核心程序集（与 runtime/ 内版本完全一致） -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(RuntimeCoreDir)BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(RuntimeCoreDir)BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(RuntimeCoreDir)Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RuntimeCoreDir)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 0.7.0 类型代理程序集（预生成，见 runtime/BepInEx/interop） -->
    <Reference Include="$(RuntimeInteropDir)*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 构建后拷贝到部署游戏目录（仅当 GameDir 有效时） -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(GameDir)' != '' And Exists('$(GameDir)MinecraftVSZombies2.exe')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)BepInEx\plugins\" />
  </Target>

</Project>
